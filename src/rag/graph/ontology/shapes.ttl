ccop:BusinessEntityShape
    a sh:NodeShape ;
    sh:targetClass ccop:BusinessEntity ;
    sh:property ccop:CanonicalNameConstraint .

# ---------------------------------------------------------------------------
# Seeded clause-backbone NodeShapes (clause_id required) — D-09 / D-10
# ---------------------------------------------------------------------------

ccop:ClauseShape
    a sh:NodeShape ;
    sh:targetClass ccop:Clause ;
    sh:property ccop:ClauseIdConstraint .

ccop:ScopeClauseShape
    a sh:NodeShape ;
    sh:targetClass ccop:ScopeClause ;
    sh:property ccop:ClauseIdConstraint .

ccop:ControlClauseShape
    a sh:NodeShape ;
    sh:targetClass ccop:ControlClause ;
    sh:property ccop:ClauseIdConstraint .

ccop:DefinitionClauseShape
    a sh:NodeShape ;
    sh:targetClass ccop:DefinitionClause ;
    sh:property ccop:ClauseIdConstraint .
