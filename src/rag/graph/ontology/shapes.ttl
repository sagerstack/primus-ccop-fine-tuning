ccop:CybersecurityIncidentShape
    a sh:NodeShape ;
    sh:targetClass ccop:CybersecurityIncident ;
    sh:property ccop:CanonicalNameConstraint .

ccop:CybersecurityTrainingShape
    a sh:NodeShape ;
    sh:targetClass ccop:CybersecurityTraining ;
    sh:property ccop:CanonicalNameConstraint .

ccop:IncidentManagementShape
    a sh:NodeShape ;
    sh:targetClass ccop:IncidentManagement ;
    sh:property ccop:CanonicalNameConstraint .

ccop:CyberThreatIntelligenceShape
    a sh:NodeShape ;
    sh:targetClass ccop:CyberThreatIntelligence ;
    sh:property ccop:CanonicalNameConstraint .

ccop:ControlShape
    a sh:NodeShape ;
    sh:targetClass ccop:Control ;
    sh:property ccop:CanonicalNameConstraint .

ccop:ObligationShape
    a sh:NodeShape ;
    sh:targetClass ccop:Obligation ;
    sh:property ccop:CanonicalNameConstraint .

ccop:DefinitionShape
    a sh:NodeShape ;
    sh:targetClass ccop:Definition ;
    sh:property ccop:CanonicalNameConstraint .

ccop:OperationalTechnologyShape
    a sh:NodeShape ;
    sh:targetClass ccop:OperationalTechnology ;
    sh:property ccop:CanonicalNameConstraint .

ccop:ThirdPartyShape
