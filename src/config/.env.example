# CCoP 2.0 Model Evaluation Framework - Environment Configuration

# ============================================================================
# Ollama Configuration
# ============================================================================
CCOP_OLLAMA_HOST=http://localhost:11434
CCOP_OLLAMA_TIMEOUT=300

# ============================================================================
# Claude CLI Configuration
# ============================================================================
CCOP_CLAUDE_CLI_TIMEOUT=120

# ============================================================================
# LLM Judge Configuration (Layer 1 - benchmark scoring)
# ============================================================================
CCOP_LLM_JUDGE_MODEL=sonnet  # DEPRECATED: legacy Claude CLI judge (kept for backward-compat)

# ============================================================================
# OpenRouter Judge Configuration (Path B 2-judge methodology)
# See: research/llm-judge-cybersec/followup-openrouter-judge/30-recommendation.md
# ============================================================================
# Get your key: https://openrouter.ai -> Dashboard -> Keys (free signup + load credit)
# Store the real key in .env.local (gitignored), NOT in this file
CCOP_OPENROUTER_API_KEY=sk-or-v1-your-key-here
CCOP_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Primary judge: Qwen3-235B-A22B (Alibaba MoE, ~$9.86/30K calls)
# Runs on every eval. Dated slug for reproducibility.
CCOP_JUDGE_PRIMARY_MODEL=qwen/qwen3-235b-a22b-07-25

# Secondary judge: GPT-4o-mini (OpenAI, ~$30.15/30K calls)
# Runs ONLY for inter-judge kappa measurement snapshots (pre-A1, post-A1, post-enrichment)
CCOP_JUDGE_SECONDARY_MODEL=openai/gpt-4o-mini-2024-07-18

# Judge inference parameters
CCOP_JUDGE_TEMPERATURE=0.2  # Variance-reduction sweet spot (MT-Bench + Prometheus 2 calibration)
CCOP_JUDGE_MAX_RETRIES=3
CCOP_JUDGE_TIMEOUT=60

# ============================================================================
# Model Configuration
# ============================================================================
CCOP_MODEL_NAME=primus-reasoning
CCOP_MODEL_HF_REPO=trendmicro-ailab/Llama-Primus-Reasoning
CCOP_MODEL_QUANTIZATION=Q5_K_M  # Options: Q4_K_M, Q5_K_M, Q6_K, Q8_0
CCOP_MODEL_CACHE_DIR=~/.cache/ccop-models

# ============================================================================
# Evaluation Configuration
# ============================================================================
CCOP_TEST_CASES_DIR=../ground-truth/test-suite
CCOP_RESULTS_DIR=results/evaluations
CCOP_MAX_CONCURRENT_EVALUATIONS=3

# ============================================================================
# LLM Inference Parameters
# ============================================================================
CCOP_DEFAULT_TEMPERATURE=0.3  # 0.3 balances reproducibility with reasoning depth
CCOP_DEFAULT_TOP_P=0.9
CCOP_DEFAULT_TOP_K=40
CCOP_DEFAULT_MAX_TOKENS=1024
CCOP_CONTEXT_LENGTH=4096

# ============================================================================
# Logging Configuration
# ============================================================================
CCOP_LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
CCOP_LOG_FORMAT=json  # Options: json, console
CCOP_LOG_FILE=logs/ccop-eval.log

# ============================================================================
# HuggingFace Configuration
# ============================================================================
# HF_TOKEN=your_huggingface_token_here  # Optional: for private models or faster downloads
# HF_HOME=~/.cache/huggingface

# ============================================================================
# Development/Debug Configuration
# ============================================================================
CCOP_DEBUG=false
CCOP_MOCK_MODE=false  # Set to true to use mock gateway instead of real Ollama

# ============================================================================
# Databricks Configuration (RAG Infrastructure)
# ============================================================================
CCOP_DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
CCOP_DATABRICKS_TOKEN=your_databricks_token
CCOP_DATABRICKS_CATALOG=main
CCOP_DATABRICKS_SCHEMA=ccop_compliance
CCOP_DATABRICKS_VECTOR_SEARCH_ENDPOINT=ccop-vector-search
CCOP_DATABRICKS_EMBEDDING_ENDPOINT=databricks-bge-large-en
CCOP_DATABRICKS_WAREHOUSE_ID=your_sql_warehouse_id

# ============================================================================
# Ingestion Pipeline Configuration
# ============================================================================
CCOP_PREAMBLE_MAX_WORDS=500
CCOP_SECTION_CHUNK_MIN_TOKENS=200
CCOP_SECTION_CHUNK_MAX_TOKENS=1000
# Diagram Captioning (GLM-4V via ZhipuAI)
CCOP_DIAGRAM_CAPTIONING_ENABLED=false
CCOP_ZHIPUAI_API_KEY=your_zhipuai_api_key_here
CCOP_ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CCOP_ZHIPUAI_MODEL=glm-4.6v
CCOP_ZHIPUAI_TIMEOUT=60
CCOP_ZHIPUAI_MAX_TOKENS=512
CCOP_DIAGRAM_CAPTIONING_PROMPT=Describe this diagram from a cybersecurity regulatory document. Focus on the structure, relationships, and key information conveyed. Be concise and factual.
CCOP_GARBLED_TEXT_REPETITION_THRESHOLD=5

# ============================================================================
# Qdrant Configuration (Local RAG)
# ============================================================================
CCOP_QDRANT_URL=http://localhost:6333
CCOP_QDRANT_COLLECTION_NAME=ccop_clauses_hybrid
CCOP_QDRANT_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
CCOP_QDRANT_SPARSE_MODEL=Qdrant/bm25

# ============================================================================
# Neo4j GraphRAG (Phase 9 — emergent-KG baseline)
# ============================================================================
# Local Docker Neo4j (docker compose up -d neo4j). Browser: http://localhost:7474
CCOP_NEO4J_URI=bolt://localhost:7687
CCOP_NEO4J_USER=neo4j
# Password: set a value in config/.env.local (gitignored) BEFORE 'docker compose up neo4j'.
# Must match docker-compose NEO4J_AUTH. Never commit a real secret here — placeholder only.
CCOP_NEO4J_PASSWORD=  # set a value before 'docker compose up neo4j'
CCOP_NEO4J_DATABASE=neo4j
CCOP_GRAPH_VECTOR_INDEX=ccop_chunk_embeddings
# GraphRAG infra models — held constant across Phase 9 and Phase 10 (D-06a/D-07).
CCOP_GRAPH_EXTRACTION_MODEL=openai/gpt-4o-mini      # extraction LLM via OpenRouter (D-06a)
CCOP_GRAPH_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5   # in-process embedder, parity with hybrid (D-07)

# Retrieval Funnel (Phase 1.3 + lab Exp #41 production-promoted config)
CCOP_RAG_RETRIEVAL_TOP_K=50            # Bumped from 20 — wider candidate pool (Exp #5)
CCOP_RERANK_TOP_N=8                    # Bumped from 3 — covers GT cardinality avg ~4.7 (Exp #3)
CCOP_CROSS_ENCODER_MODEL=BAAI/bge-reranker-large  # Domain-tuned reranker (Exp #7)

# Lab Exp #41 production-promoted retrieval architecture
CCOP_RAG_RETRIEVAL_MODE=dense                              # dense-only beats hybrid+RRF (Exp #11)
CCOP_RAG_CONTEXTUALIZATION_ENABLED=true                    # breadcrumb + context line per chunk (Exp #14, #41)
CCOP_RAG_CONTEXTUALIZATION_MODEL=openai/gpt-4o-mini        # acronyms-only prompt (Exp #41)
CCOP_RAG_HYDE_ENABLED=true                                 # hypothetical clause embedding (Exp #17)
CCOP_RAG_HYDE_MODEL=openai/gpt-4o-mini
CCOP_RAG_RRF_DENSE_WEIGHT=1.0                              # dense rank weight in RRF ensemble (Exp #28)
CCOP_RAG_RRF_CE_WEIGHT=1.5                                 # cross-encoder rank weight in RRF
CCOP_RAG_MERGE_PARENT_ENABLED=true                         # parent-child auto-merge (Exp #16, #33)
CCOP_RAG_MERGE_WINDOW=40                                   # merge sweet spot (Exp #33)
CCOP_RAG_MERGE_MIN_SIBLINGS=2
CCOP_RAG_COLLECTION_NAME_CONTEXTUAL=ccop_clauses_contextual_v3  # acronyms-only contextual collection

# ============================================================================
# RAGAs Evaluation Configuration (Phase 1.1)
# ============================================================================
CCOP_RAGAS_ENABLED=true
CCOP_RAGAS_EVALUATOR_MODEL=mistral-small-latest
CCOP_RAGAS_API_KEY=your-ragas-api-key-here
CCOP_RAGAS_API_BASE_URL=https://api.mistral.ai/v1
CCOP_RAGAS_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# ============================================================================
# Evaluation Mode Configuration (Phase 2)
# ============================================================================
# Evaluation mode controls whether test cases are evaluated with RAG augmentation
# - hybrid: Full RAG pipeline (retrieval + reranking + grading + generation)
# - llm-only: Direct LLM generation without RAG context
# Default: hybrid (requires Qdrant + Ollama running)
# Override per-run with: ccop-eval evaluate run --mode llm-only
