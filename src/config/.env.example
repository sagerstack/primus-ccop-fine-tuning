# CCoP 2.0 Model Evaluation Framework - Environment Configuration

# ============================================================================
# Ollama Configuration
# ============================================================================
CCOP_OLLAMA_HOST=http://localhost:11434
CCOP_OLLAMA_TIMEOUT=300

# ============================================================================
# Claude CLI Configuration
# ============================================================================
CCOP_CLAUDE_CLI_TIMEOUT=120

# ============================================================================
# LLM Judge Configuration (Layer 1 - benchmark scoring via Claude CLI)
# ============================================================================
CCOP_LLM_JUDGE_MODEL=sonnet

# ============================================================================
# Model Configuration
# ============================================================================
CCOP_MODEL_NAME=primus-reasoning
CCOP_MODEL_HF_REPO=trendmicro-ailab/Llama-Primus-Reasoning
CCOP_MODEL_QUANTIZATION=Q5_K_M  # Options: Q4_K_M, Q5_K_M, Q6_K, Q8_0
CCOP_MODEL_CACHE_DIR=~/.cache/ccop-models

# ============================================================================
# Evaluation Configuration
# ============================================================================
CCOP_TEST_CASES_DIR=../ground-truth/phase-2/test-suite
CCOP_RESULTS_DIR=results/evaluations
CCOP_MAX_CONCURRENT_EVALUATIONS=3

# ============================================================================
# LLM Inference Parameters
# ============================================================================
CCOP_DEFAULT_TEMPERATURE=0.7
CCOP_DEFAULT_TOP_P=0.9
CCOP_DEFAULT_TOP_K=40
CCOP_DEFAULT_MAX_TOKENS=1024
CCOP_CONTEXT_LENGTH=4096

# ============================================================================
# Logging Configuration
# ============================================================================
CCOP_LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
CCOP_LOG_FORMAT=json  # Options: json, console
CCOP_LOG_FILE=logs/ccop-eval.log

# ============================================================================
# HuggingFace Configuration
# ============================================================================
# HF_TOKEN=your_huggingface_token_here  # Optional: for private models or faster downloads
# HF_HOME=~/.cache/huggingface

# ============================================================================
# Development/Debug Configuration
# ============================================================================
CCOP_DEBUG=false
CCOP_MOCK_MODE=false  # Set to true to use mock gateway instead of real Ollama

# ============================================================================
# Databricks Configuration (RAG Infrastructure)
# ============================================================================
CCOP_DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
CCOP_DATABRICKS_TOKEN=your_databricks_token
CCOP_DATABRICKS_CATALOG=main
CCOP_DATABRICKS_SCHEMA=ccop_compliance
CCOP_DATABRICKS_VECTOR_SEARCH_ENDPOINT=ccop-vector-search
CCOP_DATABRICKS_EMBEDDING_ENDPOINT=databricks-bge-large-en
CCOP_DATABRICKS_WAREHOUSE_ID=your_sql_warehouse_id

# ============================================================================
# Ingestion Pipeline Configuration
# ============================================================================
CCOP_PREAMBLE_MAX_WORDS=500
CCOP_SECTION_CHUNK_MIN_TOKENS=200
CCOP_SECTION_CHUNK_MAX_TOKENS=1000
# Diagram Captioning (GLM-4V via ZhipuAI)
CCOP_DIAGRAM_CAPTIONING_ENABLED=false
CCOP_ZHIPUAI_API_KEY=your_zhipuai_api_key_here
CCOP_ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CCOP_ZHIPUAI_MODEL=glm-4.6v
CCOP_ZHIPUAI_TIMEOUT=60
CCOP_ZHIPUAI_MAX_TOKENS=512
CCOP_DIAGRAM_CAPTIONING_PROMPT=Describe this diagram from a cybersecurity regulatory document. Focus on the structure, relationships, and key information conveyed. Be concise and factual.
CCOP_GARBLED_TEXT_REPETITION_THRESHOLD=5

# ============================================================================
# Qdrant Configuration (Local RAG)
# ============================================================================
CCOP_QDRANT_URL=http://localhost:6333
CCOP_QDRANT_COLLECTION_NAME=ccop_clauses_hybrid
CCOP_QDRANT_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
CCOP_QDRANT_SPARSE_MODEL=Qdrant/bm25

# Retrieval Funnel (Phase 1.3)
CCOP_RAG_RETRIEVAL_TOP_K=20
CCOP_RERANK_TOP_N=3
CCOP_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L12-v2

# ============================================================================
# RAGAs Evaluation Configuration (Phase 1.1)
# ============================================================================
CCOP_RAGAS_ENABLED=true
CCOP_RAGAS_EVALUATOR_MODEL=mistral-small-latest
CCOP_RAGAS_API_KEY=your-ragas-api-key-here
CCOP_RAGAS_API_BASE_URL=https://api.mistral.ai/v1
CCOP_RAGAS_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# ============================================================================
# Evaluation Mode Configuration (Phase 2)
# ============================================================================
# Evaluation mode controls whether test cases are evaluated with RAG augmentation
# - hybrid: Full RAG pipeline (retrieval + reranking + grading + generation)
# - llm-only: Direct LLM generation without RAG context
# Default: hybrid (requires Qdrant + Ollama running)
# Override per-run with: ccop-eval evaluate run --mode llm-only
