{"test_id": "B18-001", "version": "2.0", "benchmark_id": "B18", "input": {"question": "Under Singapore's Cybersecurity Act 2018 and CCoP 2.0, who is personally liable for CII compliance violations? What are the responsibilities of the Board, CIIO, and CISO?", "scenario_sector": "banking", "scenario_role": "risk_manager"}, "ground_truth": {"expected_label": "compliant", "expected_response": "Under the Cybersecurity Act 2018, the CIIO (Chief Information Security Officer) is personally liable for CII compliance. The Board is responsible for governance and oversight. The CISO is responsible for operational implementation. Section 11 of the Cybersecurity Act establishes personal liability for CIIOs for CII compliance.", "key_facts": [{"fact": "CIIO is personally liable for CII compliance under Cybersecurity Act 2018 Section 11", "source": "Cybersecurity Act 2018 Section 11", "tier": "critical"}, {"fact": "Board is responsible for CII governance and oversight", "source": "CCoP 2.0 Section 1", "tier": "important"}, {"fact": "CISO is responsible for operational security implementation", "source": "CCoP 2.0 Section 1", "tier": "important"}]}, "fail_conditions": {"forbidden_claims": ["Board members are personally liable", "CISO is personally liable"], "hallucination_patterns": ["Non-existent personal liability for non-CIIOs"]}, "metadata": {"section": "CCoP 2.0 Section 1", "clause_reference": ["Section 11 Cybersecurity Act"], "domain": "IT", "difficulty": "medium", "scenario_type": "responsibility_attribution", "related_sections": [], "test_category": "edge_case", "created_date": "2026-04-01", "reviewer": null}}
