hallucination_patterns": ["Inventing specific regulatory provisions", "Creating non-existent regulatory overlaps"]}, "metadata": {"section": "N/A (multi-regulator coordination is not addressed in CCoP 2.0; remove or set to null)", "clause_reference": ["1.6.1", "1.6.2", "1.6.3", "3.2.1", "7.1.1(b)"], "domain": "IT", "difficulty": "medium", "scenario_type": "regulatory_coordination", "related_sections": [], "test_category": "edge_case", "created_date": "2026-04-01", "reviewer": null, "support_citations": ["Cybersecurity Act 2018 §11(7)"]}}
