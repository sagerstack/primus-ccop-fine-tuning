{"test_id": "B3-001", "version": "2.0", "benchmark_id": "B3", "input": {"question": "Your organization uses shared admin accounts with session logging for CII SCADA systems because the legacy HMIs don't support individual authentication. The CISO argues this satisfies CCoP access control requirements through compensating controls. Does this approach comply with CCoP 2.0?", "scenario_sector": "energy", "scenario_role": "risk_manager"}, "ground_truth": {"expected_label": "non-compliant", "expected_response": "Shared admin accounts on CII SCADA systems do not comply with CCoP 2.0. Clause 5.3.1(c) mandates individual accountability. Session logging records what happened but cannot establish who performed it. Pursue a Section 11(7) waiver documenting technical constraints and migration timeline.", "key_facts": [{"fact": "Clause 5.3.1(c) requires individual accountability for privileged access", "source": "CCoP 2.0 Section 5.3.1(c)", "tier": "critical"}, {"fact": "Shared accounts prevent individual attribution of actions", "source": "Regulatory interpretation", "tier": "critical"}, {"fact": "Session logging cannot replace individual authentication", "source": "CCoP security principles", "tier": "important"}]}, "fail_conditions": {"forbidden_claims": ["Compensating controls substitute for MFA", "Session logging satisfies accountability"], "hallucination_patterns": ["Non-existent clause allowing shared accounts"]}, "metadata": {"section": "CCoP 2.0 Section 5", "clause_reference": ["5.3.1(c)"], "domain": "OT", "difficulty": "medium", "scenario_type": "insufficient_segmentation", "related_sections": [], "test_category": "negative", "created_date": "2026-04-01", "reviewer": null}}
{"test_id": "B3-002", "version": "2.0", "benchmark_id": "B3", "input": {"question": "Conditional compliance scenario 2 for CII organization in Singapore. Does the proposed approach comply with CCoP 2.0?", "scenario_sector": "energy", "scenario_role": "risk_manager"}, "ground_truth": {"expected_label": "non-compliant", "expected_response": "CCoP 2.0 has specific requirements that must be met. The proposed approach does not satisfy these requirements. A Section 11(7) waiver may be applicable if genuine technical constraints exist.", "key_facts": [{"fact": "CCoP 2.0 requirements are mandatory for CII organizations", "source": "CCoP 2.0", "tier": "critical"}, {"fact": "Compliance requires meeting all specified controls", "source": "CCoP 2.0 principles", "tier": "important"}]}, "fail_conditions": {"forbidden_claims": ["Proposed approach satisfies CCoP without waiver", "Operational convenience justifies non-compliance"], "hallucination_patterns": ["Non-existent exemption for described scenario"]}, "metadata": {"section": "CCoP 2.0", "clause_reference": ["Section 2"], "domain": "OT", "difficulty": "medium", "scenario_type": "conditional_compliance", "related_sections": [], "test_category": "negative", "created_date": "2026-04-01", "reviewer": null}}
