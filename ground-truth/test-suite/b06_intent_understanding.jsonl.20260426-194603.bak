intent not aligned with CCoP 2.0 principles", "Creating non-existent security objectives"]}, "metadata": {"section": "8", "clause_reference": ["8.1.1"], "domain": "IT", "difficulty": "medium", "scenario_type": "intent_analysis", "related_sections": [], "test_category": "edge_case", "created_date": "2026-04-01", "reviewer": null}}
