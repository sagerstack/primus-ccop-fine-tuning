tion": "8", "clause_reference": ["8.2.2"], "domain": "IT", "difficulty": "medium", "scenario_type": "negative", "related_sections": [], "test_category": "edge_case", "created_date": "2026-04-01", "reviewer": null}}
{"test_id": "B05-023", "version": "2.0", "benchmark_id": "B05", "input": {"question": "Storing 12 months of logs is expensive. Can we use 6 months instead?", "scenario_sector": "energy", "scenario_role": "risk_manager"}, "ground_truth": {"key_facts": [{"fact": "12-month retention is mandatory", "tier": "critical", "source": "CCoP 2.0 6.3.2"}, {"fact": "No cost-based exemptions provided", "tier": "important", "source": "CCoP 2.0 6.3.2"}, {"fact": "Log aggregation/compression can reduce storage costs", "tier": "supporting", "source": "CCoP 2.0 6.3.2"}], "expected_response": "According to CCoP 2.0 Section 6.3.2, logging retention too expensive requirements are as follows:\n\n12-month retention is mandatory (critical) No cost-based exemptions provided (important) Log aggregation/compression can reduce storage costs (supporting).\n\nThe intent of this control is to ensure adequate security measures are in place for logging & monitoring. Organizations must implement controls proportionate to their risk profile while ensuring the core requirements are met.\n\nReference: CCoP 2.0, 6.3.2", "reasoning_chain": ["Identify CCoP 2.0 clause 6.3.2 as the authoritative source", "Extract specific control requirements for logging retention too expensive", "Map requirements to organizational context and risk profile"]}, "fail_conditions": {"forbidden_claims": ["Stating that logging retention too expensive requirements are optional or discretionary", "Confusing similar but distinct control requirements", "Attributing requirements to wrong CCoP clauses", "Specific control requirements from the cited clause", "Mandatory elements marked as critical in key_facts", "Reference to the applicable CCoP clause"], "hallucination_patterns": ["Inventing specific thresholds or requirements not in CCoP 2.0", "Citing non-existent subsections or additional requirements"]}, "metadata": {"section": "6", "clause_reference": ["6.3.2"], "domain": "IT", "difficulty": "medium", "scenario_type": "negative", "related_sections": [], "test_category": "edge_case", "created_date": "2026-04-01", "reviewer": null}}
{"test_id": "B05-024", "version": "2.0", "benchmark_id": "B05", "input": {"question": "We're a small CII operator with limited resources. Are there scaled requirements?", "scenario_sector": "energy", "scenario_role": "risk_manager"}, "ground_truth": {"key_facts": [{"fact": "No size-based exemptions from core requirements", "tier": "critical", "source": "CCoP 2.0 3.1"}, {"fact": "Implementation can be risk-based and proportionate", "tier": "important", "source": "CCoP 2.0 3.1"}, {"fact": "CSA may provide guidance but not waivers", "tier": "supporting", "source": "CCoP 2.0 3.1"}], "expected_response": "According to CCoP 2.0 Section 3.1, small operator exemption requirements are as follows:\n\nNo size-based exemptions from core requirements (critical) Implementation can be risk-based and proportionate (important) CSA may provide guidance but not waivers (supporting).\n\nThe intent of this control is to ensure adequate security measures are in place for scope & applicability. Organizations must implement controls proportionate to their risk profile while ensuring the core requirements are met.\n\nReference: CCoP 2.0, 3.1", "reasoning_chain": ["Identify CCoP 2.0 clause 3.1 as the authoritative source", "Extract specific control requirements for small operator exemption", "Map requirements to organizational context and risk profile"]}, "fail_conditions": {"forbidden_claims": ["Stating that small operator exemption requirements are optional or discretionary", "Confusing similar but distinct control requirements", "Attributing requirements to wrong CCoP clauses", "Specific control requirements from the cited clause", "Mandatory elements marked as critical in key_facts", "Reference to the applicable CCoP clause"], "hallucination_patterns": ["Inventing specific thresholds or requirements not in CCoP 2.0", "Citing non-existent subsections or additional requirements"]}, "metadata": {"section": "3", "clause_reference": ["3.1"], "domain": "IT", "difficulty": "medium", "scenario_type": "negative", "related_sections": [], "test_category": "edge_case", "created_date": "2026-04-01", "reviewer": null}}
{"test_id": "B05-025", "version": "2.0", "benchmark_id": "B05", "input": {"question": "Our existing controls were implemented before CCoP 2.0. Do we need to change them?", "scenario_sector": "energy", "scenario_role": "risk_manager"}, "ground_truth": {"key_facts": [{"fact": "Existing controls must meet CCoP 2.0 standards", "tier": "critical", "source": "CCoP 2.0 2.1"}, {"fact": "Gap analysis required", "tier": "critical", "source": "CCoP 2.0 2.1"}, {"fact": "Remediation timeline for non-compliant controls", "tier": "important", "source": "CCoP 2.0 2.1"}], "expected_response": "According to CCoP 2.0 Section 2.1, existing controls grandfathered requirements are as follows:\n\nExisting controls must meet CCoP 2.0 standards (critical) Gap analysis required (critical) Remediation timeline for non-compliant controls (important).\n\nThe intent of this control is to ensure adequate security measures are in place for compliance. Organizations must implement controls proportionate to their risk profile while ensuring the core requirements are met.\n\nReference: CCoP 2.0, 2.1", "reasoning_chain": ["Identify CCoP 2.0 clause 2.1 as the authoritative source", "Extract specific control requirements for existing controls grandfathered", "Map requirements to organizational context and risk profile"]}, "fail_conditions": {"forbidden_claims": ["Stating that existing controls grandfathered requirements are optional or discretionary", "Confusing similar but distinct control requirements", "Attributing requirements to wrong CCoP clauses", "Specific control requirements from the cited clause", "Mandatory elements marked as critical in key_facts", "Reference to the applicable CCoP clause"], "hallucination_patterns": ["Inventing specific thresholds or requirements not in CCoP 2.0", "Citing non-existent subsections or additional requirements"]}, "metadata": {"section": "2", "clause_reference": ["2.1"], "domain": "IT", "difficulty": "medium", "scenario_type": "negative", "related_sections": [], "test_category": "edge_case", "created_date": "2026-04-01", "reviewer": null}}
